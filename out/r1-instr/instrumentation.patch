diff --git a/fs/exec.c b/fs/exec.c
index 3e2de29a..3c37126f 100644
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -67,6 +67,8 @@
 
 #include <trace/events/sched.h>
 
+extern void r1_mark_phys(unsigned int slot, u32 val);
+
 int suid_dumpable = 0;
 
 static LIST_HEAD(formats);
@@ -1042,6 +1044,16 @@ static int exec_mmap(struct mm_struct *mm)
 	tsk->mm = mm;
 	tsk->active_mm = mm;
 	activate_mm(active_mm, mm);
+	{
+		unsigned long r1_ttbr0;
+		asm volatile("mrs %0, ttbr0_el1" : "=r" (r1_ttbr0));
+		r1_mark_phys(4, (u32)r1_ttbr0);
+		asm volatile("tlbi vmalle1\n\t"
+			     "ic iallu\n\t"
+			     "dsb sy\n\t"
+			     "isb" : : : "memory");
+		r1_mark_phys(11, 0x5A31C0F1);
+	}
 	tsk->mm->vmacache_seqnum = 0;
 	vmacache_flush(tsk);
 	task_unlock(tsk);
diff --git a/kernel/panic.c b/kernel/panic.c
index 535ee50a..c56e3a63 100644
--- a/kernel/panic.c
+++ b/kernel/panic.c
@@ -25,6 +25,9 @@
 #include <linux/nmi.h>
 #include <linux/console.h>
 #include <linux/bug.h>
+#include <asm/barrier.h>
+#include <asm/cacheflush.h>
+#include <asm/memory.h>
 #ifdef CONFIG_AMLOGIC_RAMDUMP
 #include <linux/amlogic/ramdump.h>
 #endif
@@ -608,6 +611,23 @@ EXPORT_SYMBOL(__stack_chk_fail);
 
 #endif
 
+/* Vendor GPU/VPU modules reference this symbol; keep their loader happy. */
+int pstore_io_save(void *a, unsigned long b, void *c, unsigned int d, void *e)
+{
+	volatile u32 *p = (volatile u32 *)phys_to_virt(0x075fb140UL);
+
+	/* No printk: capture the five arguments even without a live console. */
+	p[0] = (u32)(uintptr_t)a;
+	p[1] = (u32)b;
+	p[2] = (u32)(uintptr_t)c;
+	p[3] = d;
+	p[4] = (u32)(uintptr_t)e;
+	dsb(sy);
+	__clean_dcache_area_poc((void *)p, 5 * sizeof(u32));
+	return 0;
+}
+EXPORT_SYMBOL_GPL(pstore_io_save);
+
 core_param(panic, panic_timeout, int, 0644);
